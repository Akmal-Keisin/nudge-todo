# Copy to .env and fill in. .env is gitignored and must stay secret.

# The hostname the API is served on. Its A/AAAA record must point at this box
# before you start Caddy, or the ACME challenge will fail.
NUDGE_DOMAIN=nudge.example.com

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# The bearer token every device sends. Generate with:
#   openssl rand -base64 32
API_TOKEN=change-me

# Optional overrides.
ARCHIVE_RETENTION_DAYS=14
RATE_LIMIT_PER_MINUTE=60
IP_RATE_LIMIT_PER_MINUTE=120
