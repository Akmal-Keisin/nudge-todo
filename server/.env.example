# Required. Clients send this as `Authorization: Bearer <token>`.
# Generate one with:  openssl rand -base64 32
API_TOKEN=change-me

# Listen port.
PORT=8080

# SQLite file. Use an absolute path in a volume for Docker.
DB_PATH=./nudge.db

# How long archived todos are kept before the prune job deletes them.
ARCHIVE_RETENTION_DAYS=14

# Requests per minute per token.
RATE_LIMIT_PER_MINUTE=60

# Requests per minute per client address, checked before auth so that guessing
# tokens is bounded too.
IP_RATE_LIMIT_PER_MINUTE=120

# Maximum request body size in bytes.
BODY_LIMIT_BYTES=4096
